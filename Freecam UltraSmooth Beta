local hiddenGuis = {}

local function setGameUICleared(state)
    isGameUICleared = state
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, not state)
    end)

    if state then
        hiddenGuis = {}
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "FreeCamGui" and gui.Name ~= "FreeCamNotifGui" and gui.Enabled then
                table.insert(hiddenGuis, gui)
                gui.Enabled = false
            end
        end
    else
        for _, gui in ipairs(hiddenGuis) do
            if gui and gui.Parent then
                gui.Enabled = true
            end
        end
        hiddenGuis = {}
    end
end

