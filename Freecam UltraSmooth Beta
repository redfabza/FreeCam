local initialPinchDistance = nil
local initialFOV = minFOV

track(UIS.TouchPinch:Connect(function(touchPositions, scale, velocity, state)
    if not toggle.Value then return end
    if state == Enum.UserInputState.Begin then
        initialPinchDistance = (touchPositions[1] - touchPositions[2]).Magnitude
        initialFOV = targetFOV
    elseif state == Enum.UserInputState.Change and initialPinchDistance then
        local currentDistance = (touchPositions[1] - touchPositions[2]).Magnitude
        local distanceDelta = currentDistance - initialPinchDistance
        targetFOV = math.clamp(initialFOV - (distanceDelta * 0.15), minFOV, maxFOV)
    elseif state == Enum.UserInputState.End then
        initialPinchDistance = nil
    end
end))

