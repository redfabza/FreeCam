-- MAIN RENDER LOOP & ULTRA SMOOTH INTERPOLATION
----------------------------------------------------------------
local function applyToggle(state)
    if state then
        targetCFrame = camera.CFrame
        camCFrame = camera.CFrame
        local rx, ry, rz = camCFrame:ToOrientation()
        pitch = rx
        yaw = ry
        targetPitch = rx
        targetYaw = ry
        roll = rz
        targetRoll = rz

        camera.CameraType = Enum.CameraType.Scriptable
        camera.CameraSubject = nil
        toggleBtn.Text = "⏻   FreeCam: ON"
        tween(toggleBtn, {BackgroundColor3 = Theme.Green}, 0.15)
        tween(dot, {BackgroundColor3 = Theme.Cyan}, 0.15)
    else
        camera.CameraType = Enum.CameraType.Custom
        local char = player.Character or player.CharacterAdded:Wait()
        camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
        player.CameraMinZoomDistance = origMinZoom
        player.CameraMaxZoomDistance = origMaxZoom
        toggleBtn.Text = "⏻   FreeCam: OFF"
        tween(toggleBtn, {BackgroundColor3 = Theme.Off}, 0.15)
        tween(dot, {BackgroundColor3 = Theme.Green}, 0.15)
    end
    updateElementsVisible()
end

track(toggle.Changed:Connect(applyToggle))
applyToggle(toggle.Value)

track(toggleBtn.MouseButton1Click:Connect(function()
    toggle.Value = not toggle.Value
end))

track(RunService.RenderStepped:Connect(function(dt)
    if toggle.Value then
        if camera.CameraType ~= Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CameraSubject = nil
        end

        if isHoldingZoomIn then
            targetFOV = math.clamp(targetFOV - (40 * dt), minFOV, maxFOV)
        elseif isHoldingZoomOut then
            targetFOV = math.clamp(targetFOV + (40 * dt), minFOV, maxFOV)
        end

        local isLeanLeft = isHoldingLeanLeft or UIS:IsKeyDown(Enum.KeyCode.C)
        local isLeanRight = isHoldingLeanRight or UIS:IsKeyDown(Enum.KeyCode.V)

        if UIS:IsKeyDown(Enum.KeyCode.B) then
            targetRoll = 0
        elseif isLeanLeft then
            targetRoll = targetRoll + (leanSpeed * dt)
        elseif isLeanRight then
            targetRoll = targetRoll - (leanSpeed * dt)
        end

        camera.FieldOfView = camera.FieldOfView + (targetFOV - camera.FieldOfView) * math.min(dt * 12, 1)

        -- Ultra Smooth Inertia สำหรับการหมุน (Interpolate มุม Yaw และ Pitch)
        local rotSmoothFactor = math.clamp(1 - (cameraSmoothness * 0.9), 0.05, 1.0)
        yaw = yaw + (targetYaw - yaw) * math.min(dt * rotSmoothFactor * 25, 1)
        pitch = pitch + (targetPitch - pitch) * math.min(dt * rotSmoothFactor * 25, 1)

        local moveDir = Vector3.new(0, 0, 0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(0, 0, -1) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Vector3.new(0, 0, 1) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Vector3.new(-1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir + Vector3.new(0, -1, 0) end

        local joyLevel = _G.JoystickData.DraggingLevel
        local joyDir = _G.JoystickData.Direction
        if joyLevel > 0 then
            moveDir = moveDir + Vector3.new(joyDir.X, 0, joyDir.Z) * joyLevel
        end

        roll = roll + (targetRoll - roll) * math.min(dt * 12, 1)
        local rotCFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll)
        
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
            local worldMove = rotCFrame:VectorToWorldSpace(moveDir)
            targetCFrame = targetCFrame + (worldMove * cameraSpeed * dt * 50)
        end

        targetCFrame = CFrame.new(targetCFrame.Position) * rotCFrame

        -- Lerp ตำแหน่งกล้องแบบ Ultra Smooth
        local lerpSpeed = math.clamp(1 - (cameraSmoothness * 0.95), 0.01, 1.0)
        local lerpAlpha = math.clamp(lerpSpeed * dt * 35, 0.001, 1)
        
        camCFrame = camCFrame:Lerp(targetCFrame, lerpAlpha)
        camera.CFrame = camCFrame
    else
        camera.FieldOfView = camera.FieldOfView + (origFOV - camera.FieldOfView) * math.min(dt * 10, 1)
    end
end))

