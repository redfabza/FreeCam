local function tween(obj, props, dur, style)
    TweenService:Create(obj, TweenInfo.new(dur or 0.18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function addGradient(inst, colorSeq, rotation)
    local grad = Instance.new("UIGradient")
    grad.Color = colorSeq
    grad.Rotation = rotation or 90
    grad.Parent = inst
    return grad
end

local function addHover(btn, baseColor, hoverColor)
    track(btn.MouseEnter:Connect(function()
        tween(btn, {BackgroundColor3 = hoverColor}, 0.12)
    end))
    track(btn.MouseLeave:Connect(function()
        tween(btn, {BackgroundColor3 = baseColor}, 0.12)
    end))
end

