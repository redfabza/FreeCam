local function createInteractiveSlider(titleText, maxHintText, posY, minVal, maxVal, defaultVal, isPercent, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -85, 0, 14)
    label.Position = UDim2.new(0, 10, 0, posY)
    label.BackgroundTransparency = 1
    label.Text = titleText .. " " .. maxHintText
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    label.TextColor3 = Color3.fromRGB(0, 180, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = mainFrame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.fromOffset(55, 18)
    textBox.Position = UDim2.new(1, -65, 0, posY - 2)
    textBox.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    textBox.Text = isPercent and string.format("%d%%", defaultVal * 100) or string.format("%.1f", defaultVal)
    textBox.Font = Enum.Font.GothamBold
    textBox.TextSize = 10
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.ClearTextOnFocus = false
    textBox.Parent = mainFrame
    Instance.new("UICorner", textBox).CornerRadius = UDim.new(0, 4)
    local tbStroke = Instance.new("UIStroke", textBox)
    tbStroke.Color = Color3.fromRGB(60, 60, 75)
    tbStroke.Thickness = 1

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -20, 0, 10)
    bg.Position = UDim2.new(0, 10, 0, posY + 18)
    bg.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    bg.BorderSizePixel = 0
    bg.Parent = mainFrame
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local initRatio = (defaultVal - minVal) / (maxVal - minVal)
    fill.Size = UDim2.new(math.clamp(initRatio, 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function setVal(newVal, updateTextBox)
        local clamped = math.clamp(newVal, minVal, maxVal)
        local ratio = (clamped - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
        
        if updateTextBox then
            if isPercent then
                textBox.Text = string.format("%d%%", math.floor(clamped * 100))
            else
                textBox.Text = string.format("%.1f", clamped)
            end
        end
        callback(clamped)
    end

    local dragging = false
    local function updateFromInput(input)
        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0.0, 1.0)
        local calculatedVal = minVal + (rel * (maxVal - minVal))
        setVal(calculatedVal, true)
    end

    track(bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end))

    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    track(textBox.FocusLost:Connect(function()
        local rawText = textBox.Text:gsub("%%", "")
        local num = tonumber(rawText)
        if num then
            if isPercent then num = num / 100 end
            setVal(num, true)
        else
            setVal(defaultVal, true)
        end
    end))
end

