local function showNotification(message, duration)
    if stealthMode then return end
    pcall(function()
        local notifGui = playerGui:FindFirstChild("FreeCamNotifGui")
        if notifGui then notifGui:Destroy() end

        notifGui = Instance.new("ScreenGui")
        notifGui.Name = "FreeCamNotifGui"
        notifGui.ResetOnSpawn = false
        notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        notifGui.Parent = playerGui

        local notifFrame = Instance.new("Frame")
        notifFrame.Size = UDim2.fromOffset(280, 48)
        notifFrame.Position = UDim2.new(0.5, -140, 0, 40)
        notifFrame.BackgroundColor3 = Theme.PanelBottom
        notifFrame.BackgroundTransparency = 0.05
        notifFrame.BorderSizePixel = 0
        notifFrame.ClipsDescendants = true
        notifFrame.Parent = notifGui
        Instance.new("UICorner", notifFrame).CornerRadius = UDim.new(0, 12)

        addGradient(notifFrame, ColorSequence.new(Theme.PanelTop, Theme.PanelBottom), 100)

        local stroke = Instance.new("UIStroke", notifFrame)
        stroke.Color = Theme.Accent
        stroke.Thickness = 1.4
        stroke.Transparency = 0.2

        local accentBar = Instance.new("Frame")
        accentBar.Size = UDim2.new(0, 4, 1, 0)
        accentBar.BackgroundColor3 = Theme.Accent
        accentBar.BorderSizePixel = 0
        accentBar.Parent = notifFrame
        Instance.new("UICorner", accentBar).CornerRadius = UDim.new(0, 12)

        local notifText = Instance.new("TextLabel")
        notifText.Size = UDim2.new(1, -20, 1, 0)
        notifText.Position = UDim2.new(0, 16, 0, 0)
        notifText.BackgroundTransparency = 1
        notifText.Text = "✦  " .. message
        notifText.Font = Enum.Font.GothamBold
        notifText.TextSize = 12
        notifText.TextColor3 = Theme.TextMain
        notifText.TextXAlignment = Enum.TextXAlignment.Left
        notifText.Parent = notifFrame

        notifFrame.BackgroundTransparency = 1
        stroke.Transparency = 1
        notifText.TextTransparency = 1
        accentBar.BackgroundTransparency = 1
        tween(notifFrame, {BackgroundTransparency = 0.05}, 0.25)
        tween(stroke, {Transparency = 0.2}, 0.25)
        tween(notifText, {TextTransparency = 0}, 0.25)
        tween(accentBar, {BackgroundTransparency = 0}, 0.25)

        task.delay(duration or 3, function()
            if notifGui and notifGui.Parent then
                tween(notifFrame, {BackgroundTransparency = 1}, 0.2)
                tween(notifText, {TextTransparency = 1}, 0.2)
                task.delay(0.2, function()
                    if notifGui and notifGui.Parent then notifGui:Destroy() end
                end)
            end
        end)
    end)
end

