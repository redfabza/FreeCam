----------------------------------------------------------------
-- JOYSTICK TOUCH LOGIC
----------------------------------------------------------------
local draggingJoy = false
local activeTouchJoy = nil
local center = Vector2.new(0,0)

local function updateCenter()
    center = Vector2.new(outer.AbsolutePosition.X + radius, outer.AbsolutePosition.Y + radius)
end

local function moveInner(posV2)
    local dir = posV2 - center
    local dist = math.min(dir.Magnitude, radius)
    local offset = dir.Magnitude > 0 and dir.Unit * dist or Vector2.new(0,0)
    inner.Position = UDim2.new(0.5, offset.X - sizeInner/2, 0.5, offset.Y - sizeInner/2)
    
    _G.JoystickData.DraggingLevel = math.clamp(dist / radius, 0, 1)
    _G.JoystickData.Direction = Vector3.new(offset.X / radius, 0, offset.Y / radius)
end

track(outer.InputBegan:Connect(function(input)
    if not toggle.Value or not showJoystick.Value then return end
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not draggingJoy then
        updateCenter()
        draggingJoy = true
        activeTouchJoy = input
        moveInner(Vector2.new(input.Position.X, input.Position.Y))
    end
end))

track(UIS.InputChanged:Connect(function(input)
    if draggingJoy and input == activeTouchJoy then
        moveInner(Vector2.new(input.Position.X, input.Position.Y))
    end
end))

local function resetJoy(input)
    if draggingJoy and input == activeTouchJoy then
        draggingJoy = false
        activeTouchJoy = nil
        inner.Position = UDim2.new(0.5, -sizeInner/2, 0.5, -sizeInner/2)
        _G.JoystickData.DraggingLevel = 0
        _G.JoystickData.Direction = Vector3.new(0,0,0)
    end
end
track(UIS.InputEnded:Connect(resetJoy))

