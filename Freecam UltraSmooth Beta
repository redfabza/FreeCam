    if closed then return end
    closed = true

    toggle.Value = false
    setGameUICleared(false)

    camera.CameraType = Enum.CameraType.Custom
    local char = player.Character
    if char then
        camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
    end
    player.CameraMinZoomDistance = origMinZoom
    player.CameraMaxZoomDistance = origMaxZoom
    camera.FieldOfView = origFOV

    for _, conn in ipairs(connections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end

    controlGui:Destroy()
    toggle:Destroy()
    showJoystick:Destroy()
    showZoomButtons:Destroy()
    showLeanButtons:Destroy()
end))

----------------------------------------------------------------
-- RESPONSIVE SCALING (auto-shrink UI on phones/small screens)
----------------------------------------------------------------
local mainScale = Instance.new("UIScale"); mainScale.Parent = mainFrame
local foldScale = Instance.new("UIScale"); foldScale.Parent = foldBtn
local helpScale = Instance.new("UIScale"); helpScale.Parent = helpFrame
local zoomScale = Instance.new("UIScale"); zoomScale.Parent = zoomFrame
local leanScale = Instance.new("UIScale"); leanScale.Parent = leanFrame
local joyScale  = Instance.new("UIScale"); joyScale.Parent = outer

local function computeUIScale()
    local vp = camera.ViewportSize
    local isTouchDevice = UIS.TouchEnabled and not UIS.MouseEnabled
    if vp.X <= 400 then
        return 0.62
    elseif vp.X <= 600 then
        return 0.72
    elseif isTouchDevice or vp.X <= 900 then
        return 0.82
    end
    return 1
end

local function applyUIScale()
    local s = computeUIScale()
    mainScale.Scale = s
    foldScale.Scale = s
    helpScale.Scale = s
    zoomScale.Scale = s
    leanScale.Scale = s
    joyScale.Scale = s
end

applyUIScale()
track(camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyUIScale))

